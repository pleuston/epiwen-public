  <ab>
                    <lb n="01"/>
                    <lb n="T08n0232_0731a15" ed="T"/>
                    <persName corresp="en-a1" key="rh0007" reg="Manjusri" type="Bodhisattva" xml:id="zh-a1">
                        <app>
                            <lem wit="T_232_1 R1 R2"> 文<g rend="variant">殊</g>
                                <g rend="variant">師</g>利</lem>
                            <rdg wit="T_232_1" type="textcritical">文殊師利</rdg>
                            <rdg wit="T_233_1" type="textcritical">文殊</rdg>
                        </app>
                    </persName>白<persName corresp="en-a2" key="bg0004" reg="Sakyamuni" type="Buddha" xml:id="zh-a2">佛</persName>言：“<lb n="02"/>
                    <persName corresp="en-a3" key="bg0004" reg="Sakyamuni" type="Buddha" xml:id="zh-a3">
                        <addName corresp="en-a4" type="honorific" xml:id="zh-a4">世<g rend="variant">尊</g>
                        </addName>
                    </persName>！何 <app>
                        <lem wit="R1 R2 T_233_1 T_232_2"/>
                        <rdg wit="T_232_1" type="textcritical">以</rdg>
                    </app> 故名<term ref="DFB18363">
                        <g rend="variant">般</g>
                        <lb n="T08n0232_0731a16" ed="T"/>若<lb n="03"/>波<g rend="variant">羅</g>
                        <g>蜜</g>
                    </term>？”<persName corresp="en-a5" key="bg0004" reg="Sakyamuni" type="Buddha" xml:id="zh-a5">佛</persName>言：“<g rend="variant">般</g>若<lb n="04"/>波<g rend="variant">羅</g>
                    <g>蜜</g>
                    <term ref="DFB22333">
                        <g>無</g>
                        <g rend="variant">邊</g>
                    </term>、<term ref="DFB22241">
                        <g>無</g>
                        <g>際</g>
                    </term>，<lb n="05"/>
                    <g>無</g>
                    <term ref="DFB09526">名</term>、<lb n="T08n0232_0731a17" ed="T"/>
                    <term ref="DFB22004">
                        <g>無</g>相</term>，非思<supplied>量</supplied>
                    <ptr target="note_zh_1"/>、<lb n="06"/>
                    <g>無</g>
                    <g/>
                    <term ref="DFB29662">
                        <g rend="variant">歸</g>依</term>、<g>無</g>
                    <term ref="DFB16865">洲渚</term>，<g>無</g>
                    <lb n="07"/>犯、<g>無</g>
                    <g rend="variant">福</g>，<g>無</g>晦、<lb n="T08n0232_0731a18" ed="T"/>
                    <g>無</g>
                    <g>朙</g>， <lb n="08"/>
                    <app>
                        <lem wit="R1 R2 T_233_3 T_232_4">如</lem>
                        <rdg wit="T_232_3" type="textcritical">猶如</rdg>
                    </app>
                    <term ref="DFB13303">法<g rend="variant">界</g>
                    </term>
                    <g>無</g>有<supplied>分齊，
                        </supplied>
                    <lb n="09"/>亦<g>無</g>限數，<supplied>是</supplied>名<supplied>般</supplied>
                    <lb n="10"/>
                    <lb n="T08n0232_0731a19" ed="T"/>若波羅<supplied>蜜</supplied>，亦名<term ref="DFB21478">菩<lb n="11"/>
                        <g rend="variant">薩</g>摩訶<supplied>薩</supplied>
                    </term>行 <supplied>處。非</supplied>
                    <lb n="12"/>
                    <app>
                        <lem wit="R1 T_232_6 T_233_2">行</lem>
                        <rdg wit="T_232_5" type="textcritical">處</rdg>
                    </app>、非不<lb n="T08n0232_0731a20" ed="T"/>
                    <supplied>行</supplied>處，<supplied>悉</supplied>入<ptr target="note_zh_3"/>
                    <lb n="13"/>
                    <term ref="DFB00292">
                        <supplied>壹乗，</supplied>
                    </term>
                    <supplied>名</supplied>非行<supplied>處</supplied>。何<lb n="14"/>
                    <supplied>以</supplied>故？<term ref="DFB21996">
                        <supplied>無</supplied>
                        <g rend="variant">念</g>
                    </term>
                    <term ref="DFB21912">
                        <supplied>無</supplied>
                        <g>作</g>
                    </term>
                    <lb n="T08n0232_0731a21" ed="T"/>故。”</ab>
